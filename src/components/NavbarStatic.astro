<header class="navbar-static">
  <a href="/" class="navbar-logo">
    <img src="/logo.svg" alt="One Flyt" class="navbar-logo-img" />
  </a>

  <nav class="navbar-links">
    <a href="/#musica">Música</a>
    <a href="/#biografia">Biografía</a>
    <a href="/#fechas">Fechas</a>
    <a href="https://www.submithub.com/link/redes" target="_blank">Redes</a>
  </nav>
</header>

<style>
  .navbar-static {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: none;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(10px);
  }

  .navbar-logo {
    display: flex;
    align-items: center;
  }

  .navbar-logo-img {
    height: 50px;
    width: auto;
    filter: invert(1);
  }

  .navbar-links {
    display: flex;
    gap: 2rem;
  }

  .navbar-links a {
    color: var(--color-text);
    text-decoration: none;
    font-family: var(--font-ui);
    font-size: 1.2rem;
    opacity: 0.85;
    transition: opacity 0.2s;
  }

  .navbar-links a:hover {
    opacity: 1;
  }

  @media (min-width: 768px) {
    .navbar-static {
      display: flex;
      padding: 1.25rem 3rem;
    }
  }
</style>
