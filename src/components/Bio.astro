---
import Image from "astro/components/Image.astro";
import oneflytPhoto from "../assets/images/oneflyt.jpg";

const paragraphs = [
  "One Flyt es el proyecto musical de Rodrigo Valdez, nacido el 11 de diciembre de 2003 (22 años) en Villa Devoto, Buenos Aires. Su sonido fusiona influencias del Drumless, R&B y Ghostpell en un universo íntimo y emocional que nació de experiencias propias.",
  "Sus canciones abordan la salud mental, la soledad y la depresión desde una mirada honesta, sin filtros pero con calma. Cada letra es un intento de poner en palabras lo que muchas veces no tiene nombre.",
  "Su música funciona como un punto de encuentro: un lugar donde las emociones encuentran voz y quienes lo escuchan pueden detenerse, respirar y encontrar algo de paz en medio del ruido diario.",
];
---

<section id="biografia" class="bio">
  <div class="bio-bg"></div>

  <div class="bio-content">
    <h2 class="bio-title fade-in">BIOGRAFÍA</h2>

    <div class="bio-grid fade-in">
      <div>
        <Image src={oneflytPhoto} alt="One Flyt" class="bio-photo" />
      </div>

      <div class="bio-text">
        {paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </div>
</section>

<style>
  .bio {
    position: relative;
    padding: var(--spacing-section) 1.5rem;
    overflow: hidden;
  }

  .bio-bg {
    position: absolute;
    inset: 0;
    background-image: url("../assets/images/background_bio.jpg");
    background-size: cover;
    background-position: center;
    opacity: 0.5;
    z-index: 0;
  }

  .bio-content {
    position: relative;
    z-index: 1;
    max-width: 1000px;
    margin: 0 auto;
  }

  .bio-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 8vw, 4rem);
    color: var(--color-text);
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .bio-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    transition-delay: 0.3s;
  }

  .bio-photo {
    width: 100%;
    height: auto;
    aspect-ratio: 3/4;
    object-fit: cover;
    border-radius: 4px;
  }

  .bio-text {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .bio-text p {
    font-family: var(--font-body);
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--color-text);
  }

  @media (min-width: 768px) {
    .bio-grid {
      display: grid;
      grid-template-columns: 400px 1fr;
      gap: 4rem;
      align-items: start;
    }

    .bio-photo {
      display: block;
    }

    .bio-text p {
      font-size: 1.4rem;
    }
  }
</style>
